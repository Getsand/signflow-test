# SignFlo API Wrapper - copy to .env and edit
# Optional: create .env only if you want to override defaults

# Port the wrapper listens on (default 9080)
# PORT=9080

# Your SignFlo backend URL (default http://127.0.0.1:8000)
BACKEND_BASE_URL=http://127.0.0.1:8000

# Backend service user: wrapper logs in with this to proxy requests (required for document APIs)
BACKEND_EMAIL=your-service-user@example.com
BACKEND_PASSWORD=your-service-password

# API key hashing secret (change in production)
API_KEY_HASH_SECRET=change-me-in-production

# Rate limits (requests per minute per API key)
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_MINUTE_PRO=500

# Wrapper DB (SQLite by default)
# DATABASE_URL=sqlite+aiosqlite:///./data/wrapper.db

# Optional: bootstrap first API key via X-Admin-Secret header
# ADMIN_SECRET=your-admin-secret

# Optional: Redis for distributed rate limiting (empty = in-memory)
# REDIS_URL=redis://localhost:6379/0

# Timeout for backend requests (seconds)
# REQUEST_TIMEOUT_SECONDS=10
