{
  "info": {
    "name": "SignFlo Public API",
    "description": "SignFlo Public API (Zoho Sign style). Auth → API Key → Documents, Templates, Field Types, Users, Requests.\n\n**Flow:** 1. Auth: Health Check, Register, Login. 2. API Keys: Create API Key (Bearer Token with jwt_token). 3. Documents: list, get types, presign, get, update, finalize, delete. 4. Templates: list, get, presign, finalize, update, add/list fields. 5. Field Types: get field types. 6. Users: me, list, get by id, invite, update, update access/role, delete. 7. Requests: list, stats, create, get, send, download, delete.\n\nSet base_url to http://127.0.0.1:8000. Use Bearer Token (not JWT Bearer) for Create API Key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "jwt_token", "value": "" },
    { "key": "api_key", "value": "" },
    { "key": "file_id", "value": "" },
    { "key": "signing_request_id", "value": "" },
    { "key": "key_id", "value": "" },
    { "key": "user_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Connection", "value": "keep-alive" }
            ],
            "url": "{{base_url}}/health"
          }
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    pm.collectionVariables.set('jwt_token', '');",
                  "    pm.test('Register OK', () => pm.response.to.have.status(201));",
                  "} else {",
                  "    pm.test('Register response', () => true);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Connection", "value": "keep-alive" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman@example.com\",\n  \"password\": \"YourPassword123\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "    pm.collectionVariables.set('jwt_token', res.access_token);",
                  "    pm.test('JWT saved to collection variable', () => true);",
                  "}",
                  "pm.test('Login OK', () => pm.response.code === 200);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Connection", "value": "keep-alive" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman@example.com\",\n  \"password\": \"YourPassword123\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "API Keys",
      "item": [
        {
          "name": "Create API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.api_key) {",
                  "    pm.collectionVariables.set('api_key', res.api_key);",
                  "    pm.test('API key saved', () => true);",
                  "}",
                  "if (res.id) pm.collectionVariables.set('key_id', res.id);",
                  "pm.test('Create API Key OK', () => pm.response.code === 201);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman test key\",\n  \"rate_limit_per_minute\": 60\n}"
            },
            "url": "{{base_url}}/api/v1/auth/api-keys"
          }
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "{{base_url}}/api/v1/api-keys"
          }
        },
        {
          "name": "Revoke API Key",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "{{base_url}}/api/v1/api-keys/{{key_id}}"
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "List Documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "    pm.collectionVariables.set('file_id', res.data[0].id);",
                  "}",
                  "pm.test('List documents OK', () => pm.response.code === 200 && res.code === 0);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/documents"
          }
        },
        {
          "name": "Get Document Types",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/documents/types"
          }
        },
        {
          "name": "Get Document",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/documents/{{file_id}}"
          }
        },
        {
          "name": "Presign Upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.file_id) {",
                  "    pm.collectionVariables.set('file_id', res.data.file_id);",
                  "}",
                  "pm.test('Presign OK', () => pm.response.code === 200 && res.code === 0);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"test-doc.pdf\",\n  \"mime_type\": \"application/pdf\"\n}"
            },
            "url": "{{base_url}}/api/v1/documents/presign"
          }
        },
        {
          "name": "Finalize Document",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/documents/{{file_id}}/finalize"
          }
        },
        {
          "name": "Update Document",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"renamed-doc.pdf\"\n}"
            },
            "url": "{{base_url}}/api/v1/documents/{{file_id}}"
          }
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/documents/{{file_id}}"
          }
        }
      ]
    },
    {
      "name": "Templates",
      "item": [
        {
          "name": "List Templates",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) { pm.collectionVariables.set('file_id', res.data[0].id); }",
                  "pm.test('List templates OK', () => pm.response.code === 200 && res.code === 0);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/templates"
          }
        },
        {
          "name": "Get Template",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/templates/{{file_id}}"
          }
        },
        {
          "name": "Presign Template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.file_id) { pm.collectionVariables.set('file_id', res.data.file_id); }",
                  "pm.test('Presign template OK', () => pm.response.code === 200 && res.code === 0);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"template.pdf\",\n  \"mime_type\": \"application/pdf\"\n}"
            },
            "url": "{{base_url}}/api/v1/templates/presign"
          }
        },
        {
          "name": "Finalize Template",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/templates/{{file_id}}/finalize"
          }
        },
        {
          "name": "Update Template",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"renamed-template.pdf\"\n}"
            },
            "url": "{{base_url}}/api/v1/templates/{{file_id}}"
          }
        },
        {
          "name": "Add Template Field",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 1,\n  \"x\": 100,\n  \"y\": 200,\n  \"width\": 120,\n  \"height\": 40,\n  \"field_type\": \"SIGNATURE\",\n  \"role\": \"Signer 1\"\n}"
            },
            "url": "{{base_url}}/api/v1/templates/{{file_id}}/fields"
          }
        },
        {
          "name": "List Template Fields",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/templates/{{file_id}}/fields"
          }
        }
      ]
    },
    {
      "name": "Field Types",
      "item": [
        {
          "name": "Get Field Types",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/field-types"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/users/me"
          }
        },
        {
          "name": "List Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0 && res.data[0].id) {",
                  "    pm.collectionVariables.set('user_id', res.data[0].id);",
                  "}",
                  "pm.test('List users OK', () => pm.response.code === 200 && res.code === 0);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/users"
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/users/{{user_id}}"
          }
        },
        {
          "name": "Invite User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invited@example.com\",\n  \"name\": \"Invited User\"\n}"
            },
            "url": "{{base_url}}/api/v1/users/invite"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\"\n}"
            },
            "url": "{{base_url}}/api/v1/users/{{user_id}}"
          }
        },
        {
          "name": "Update User Access",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true\n}"
            },
            "url": "{{base_url}}/api/v1/users/{{user_id}}/access"
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"member\"\n}"
            },
            "url": "{{base_url}}/api/v1/users/{{user_id}}/role"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/users/{{user_id}}"
          }
        }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "List Signing Requests",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "    pm.collectionVariables.set('signing_request_id', res.data[0].id);",
                  "}",
                  "pm.test('List requests OK', () => pm.response.code === 200 && res.code === 0);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/requests"
          }
        },
        {
          "name": "Get Request Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/requests/stats"
          }
        },
        {
          "name": "Create Signing Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('signing_request_id', res.data.id);",
                  "}",
                  "pm.test('Create request OK', () => pm.response.code === 201 && res.code === 0);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": \"{{file_id}}\",\n  \"title\": \"Postman test request\",\n  \"signing_order\": \"SEQUENTIAL\",\n  \"recipients\": [\n    { \"role\": \"Signer 1\", \"email\": \"signer1@example.com\", \"order_index\": 0 },\n    { \"role\": \"Signer 2\", \"email\": \"signer2@example.com\", \"order_index\": 1 }\n  ]\n}"
            },
            "url": "{{base_url}}/api/v1/requests"
          }
        },
        {
          "name": "Get Signing Request",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/requests/{{signing_request_id}}"
          }
        },
        {
          "name": "Send Signing Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/requests/{{signing_request_id}}/send"
          }
        },
        {
          "name": "Download Signed PDF",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/requests/{{signing_request_id}}/download"
          }
        },
        {
          "name": "Delete Signing Request",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
            "url": "{{base_url}}/api/v1/requests/{{signing_request_id}}"
          }
        }
      ]
    }
  ]
}
